{
  "manifest_version": 3,
  "name": "BetterSongify",
  "version": "0.1.0",
  "description": "UI improvements for the Spotify web player: translated and transliterated lyrics, video preferences, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://translate.googleapis.com/*"]
}
